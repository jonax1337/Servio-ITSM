# --- Servio environment ---
# Database (SQLite for local dev)
DATABASE_URL="file:./dev.db"

# Auth.js
# Generate a secret with: npx auth secret
AUTH_SECRET=""
AUTH_TRUST_HOST=true
NEXTAUTH_URL="http://localhost:3000"

# --- SSO / OIDC (optional; leave empty to hide the SSO button) ---
# Works with Keycloak, Authentik, Azure AD, Okta, Google, etc.
AUTH_OIDC_ID=""
AUTH_OIDC_SECRET=""
AUTH_OIDC_ISSUER=""
AUTH_OIDC_NAME="SSO"
# Login form: auto (hide the password form when SSO is set and no account has a password) | on | off.
# /login?local=1 always shows it (break-glass). docs/configuration.md#sso-only-login
AUTH_PASSWORD_LOGIN="auto"
# Optional: derive the Servio role from IdP groups (docs/configuration.md#role-mapping-from-the-idp)
AUTH_OIDC_ROLE_MAP=""
AUTH_OIDC_ROLES_CLAIM="groups"
# Optional: link a first SSO sign-in to a pre-created account (docs/configuration.md#linking-pre-created-accounts)
AUTH_OIDC_LINK_EXISTING="off"
AUTH_OIDC_LINK_CLAIM=""

# App
APP_NAME="Servio"
APP_URL="http://localhost:3000"
# Default UI language for users on "Instance default": en | de (Settings > General overrides it)
APP_LOCALE="en"

# --- REST API CORS (/api/v1 bearer-token endpoints) ---
# Default-CLOSED: when unset, NO Access-Control-Allow-Origin header is emitted,
# so browsers treat the API as same-origin-only (curl/server clients unaffected).
# Uncomment and set an exact origin to allow a cross-origin browser client:
# API_CORS_ORIGIN="https://app.example.com"

# --- Email / SMTP (optional) ---
# Leave SMTP_HOST empty to run in "outbox" mode (emails are recorded & viewable
# under Settings > Mail but not actually delivered).
SMTP_HOST=""
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="Servio Service Desk <servio@localhost>"

# --- Sable: AI Service Agent (optional, self-hosted / BYOK) — see docs/ai.md ---
# Every provider runs through the Claude Code CLI harness; all of this can also be
# set in Settings › Sable (AI assistant), which overrides these values.
# Provider: anthropic | openai | ollama | claude-code
#   ollama       = local OpenAI-compatible endpoint — no key, data never leaves the box.
#   claude-code  = drives a Claude Pro/Max subscription (CLAUDE_CODE_OAUTH_TOKEN, connect it in Settings);
#                  no API key, but data goes to Anthropic.
# Leave AI_PROVIDER at an external provider (anthropic/openai) WITHOUT AI_ALLOW_EXTERNAL=true
# and the AI features stay disabled (buttons hidden), like SMTP "outbox" mode.
AI_PROVIDER="anthropic"
# Master switch: false hides the assistant and every AI action, whatever the provider.
AI_ENABLED="true"
# Privacy gate: external providers (anthropic/openai) are BLOCKED unless this is
# exactly "true". Keep false to force local-only — nothing leaves the box.
AI_ALLOW_EXTERNAL="false"
# Optional explicit model id (else provider default: claude-sonnet-5 / gpt-4o / $OLLAMA_MODEL / sonnet)
AI_MODEL=""
# Blank = the model's own default; a set value is raised to at least 8192 (agent turns need headroom).
AI_MAX_OUTPUT_TOKENS=""
# Teaser mode: when AI is NOT enabled, still show the AI buttons as a preview.
# Clicking one shows a friendly "ask your admin to enable AI" hint (no API call).
AI_TEASER="false"
# Anthropic (external) — requires AI_ALLOW_EXTERNAL=true
ANTHROPIC_API_KEY=""
# OpenAI (external) — requires AI_ALLOW_EXTERNAL=true
OPENAI_API_KEY=""
# Optional: point at any OpenAI-compatible cloud (OpenAI, OpenRouter, Moonshot/Kimi, Zhipu/GLM…)
OPENAI_BASE_URL=""
# Ollama (local) — no key required
OLLAMA_BASE_URL="http://localhost:11434/v1"
OLLAMA_MODEL="llama3.1"

# --- File attachments / storage ---
STORAGE_DRIVER="fs"          # "fs" implemented; "s3" | "vercel-blob" are seams
UPLOAD_DIR="./.uploads"      # blob root — MUST stay outside ./public (git-ignored)
MAX_UPLOAD_MB="15"           # per-file cap in MB; lib/files.ts derives MAX_UPLOAD_BYTES

# 32-byte key (base64 or hex) for encrypting secret settings stored in the DB
# (SMTP password, AI API keys). Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
SETTINGS_ENCRYPTION_KEY=

# --- Rate limits & login throttling (all optional; defaults shown) ---
# In-memory and per-process — behind multiple replicas each keeps its own
# counters (see lib/rate-limit.ts).
# REST API (/api/v1 bearer endpoints): max requests per token (or client IP)
# per sliding window.
# API_RATE_LIMIT="120"
# API_RATE_WINDOW_MS="60000"
# AI endpoints (chat/triage/confirm-create): max requests per session user per
# window — every allowed call drives an AI provider request.
# AI_RATE_LIMIT="20"
# AI_RATE_WINDOW_MS="60000"
# Login throttle: failed attempts allowed before exponential-backoff lockout.
# LOGIN_FREE_ATTEMPTS="5"        # free failures before backoff kicks in
# LOGIN_BASE_BACKOFF_MS="2000"   # first lockout; doubles with each extra failure
# LOGIN_MAX_BACKOFF_MS="900000"  # backoff cap (15 min)
# LOGIN_DECAY_MS="900000"        # quiet period after which failures reset

# --- Background scheduler ---
# SLA escalation, inbound-mail poll, scheduled syncs, maintenance/update checks.
# Must run on EXACTLY ONE instance: set "false" on every extra replica.
# SCHEDULER_ENABLED="true"
