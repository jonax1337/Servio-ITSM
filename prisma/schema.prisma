// Servio — ITSM data model
// SQLite for local dev (swap provider to postgresql for prod).
// NOTE: SQLite has no native enums — status/priority/type are String fields
// backed by the constants in lib/constants.ts (validated with Zod).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Identity & access (Auth.js adapter models + RBAC)
// ---------------------------------------------------------------------------

model User {
  id                 String    @id @default(cuid())
  email              String    @unique
  name               String?
  passwordHash       String?
  image              String?
  role               String    @default("USER") // ADMIN | MANAGER | AGENT | USER
  isVip              Boolean   @default(false)
  jobTitle           String?
  phone              String?
  department         String?
  timezone           String    @default("UTC")
  locale             String    @default("auto") // "auto" = instance default (APP_LOCALE), else a locale code (lib/i18n/config.ts)
  signature          String? // sanitized rich-text HTML, appended to replies/emails
  signatureEnabled   Boolean   @default(false)
  emailNotifications String? // JSON: which notifications are also emailed (lib/notification-email-rules.ts); null = defaults
  isActive           Boolean   @default(true)
  isServiceAccount   Boolean   @default(false) // a non-human account (integration, break-glass, automation): receives no email at all and never sits on an approval board (lib/service-accounts.ts)
  canApproveChanges  Boolean   @default(true) // may sit on change approval boards and decide approvals; off for service accounts (set when one is marked)
  syncSourceId       String?
  externalId         String?
  lastLoginAt        DateTime?
  emailVerified      DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  accounts           Account[]
  sessions           Session[]
  secondaryEmails    UserEmail[]
  memberships        GroupMember[]
  requestedTickets   Ticket[]                @relation("TicketRequester")
  requestedOnBehalf  Ticket[]                @relation("TicketRequestedBy")
  assignedTickets    Ticket[]                @relation("TicketAssignee")
  comments           TicketComment[]
  changeComments     ChangeComment[]
  problemComments    ProblemComment[]
  watching           TicketWatcher[]
  participating      TicketParticipant[]     @relation("TicketParticipantUser")
  notifiedOn         TicketNotifiedContact[] @relation("TicketNotifiedBy")
  assignedTasks      Task[]
  workLogs           WorkLog[]
  assignedProblems   Problem[]               @relation("ProblemAssignee")
  assignedChanges    Change[]                @relation("ChangeAssignee")
  approvals          ChangeApproval[]
  entityApprovals    Approval[]              @relation("ApprovalApprover")
  requestedApprovals Approval[]              @relation("ApprovalRequester")
  ownedAssets        Asset[]                 @relation("AssetOwner")
  ownedServices      Service[]               @relation("ServiceOwner")
  catalogApprovals   CatalogItem[]           @relation("CatalogApprover")
  ticketApprovals    TicketApproval[]        @relation("TicketApprover")
  ticketMerges       TicketMerge[]           @relation("TicketMergedBy")
  ticketMergeUndos   TicketMerge[]           @relation("TicketMergeUndoneBy")
  managedGroups      Group[]                 @relation("GroupManager")
  apiTokens          ApiToken[]
  auditLogs          AuditLog[]
  appSettings        AppSetting[]
  emailTemplates     EmailTemplate[]
  notifications      Notification[]
  aiConversations    AiConversation[]        @relation("AiConversationUser")
  aiProjects         AiProject[]             @relation("AiProjectOwner")
  savedViews         SavedView[]             @relation("SavedViewOwner")
  maintenanceWindows MaintenanceWindow[]
  backupRuns         BackupRun[]
  dashboards         Dashboard[]             @relation("DashboardOwner")
  macros             Macro[]                 @relation("MacroOwner")
  articles           Article[]
  articlesApproved   Article[]               @relation("ArticleApprovedBy")
  changesCreated     Change[]                @relation("ChangeCreatedBy")
  articleRevisions   ArticleRevision[]
  articleLinks       ArticleLink[]           @relation("ArticleLinkCreator")
  attachments        Attachment[]            @relation("AttachmentUploader")
  onCallMemberships  OnCallMember[]
  onCallOverrides    OnCallOverride[]        @relation("OnCallOverrideUser")
  onCallReplacedBy   OnCallOverride[]        @relation("OnCallOverrideReplaces")
  statusUpdates      StatusIncidentUpdate[]
  ownedReleases      Release[]               @relation("ReleaseOwner")
  ownedContracts     Contract[]              @relation("ContractOwner")
  ownedLicenses      SoftwareLicense[]       @relation("LicenseOwner")
  licenseAssignments LicenseAssignment[]
  dismissedInsights  AiInsight[]             @relation("AiInsightDismissedBy")
  recurringRequested RecurringTicket[]       @relation("RecurringTicketRequester")
  recurringAssigned  RecurringTicket[]       @relation("RecurringTicketAssignee")
  recurringCreated   RecurringTicket[]       @relation("RecurringTicketCreatedBy")
  syncSource         SyncSource?             @relation(fields: [syncSourceId], references: [id])

  @@unique([syncSourceId, externalId])
  @@index([role])
  @@index([syncSourceId])
  @@index([externalId])
}

/// Admin-managed runtime configuration (SMTP, AI, branding, uploads, …).
/// Overrides the matching process.env key; secret values are AES-256-GCM
/// encrypted at rest (encrypted=true). See lib/settings.ts + lib/crypto.ts.
model AppSetting {
  id          String   @id @default(cuid())
  key         String   @unique
  value       String
  encrypted   Boolean  @default(false)
  updatedAt   DateTime @updatedAt
  updatedById String?
  updatedBy   User?    @relation(fields: [updatedById], references: [id])
}

/// A Sable skill added from the web UI (next to the built-in ones shipped in
/// `sable/skills`). Synced into Sable's isolated Claude config as
/// `skills/<name>/SKILL.md`.
model AiSkill {
  id          String   @id @default(cuid())
  /// kebab-case; also the skill's directory name. Unique across custom skills
  /// and must not collide with a built-in skill.
  name        String   @unique
  description String
  /// Markdown body of SKILL.md (without the frontmatter).
  body        String
  enabled     Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

/// A remote MCP server whose tools Sable may use (HTTP/SSE only — nothing is
/// executed on the Servio host). `mode` (AI_MCP_MODES) decides how its tools
/// run; `minRole` gates who gets them in the chat.
model AiMcpServer {
  id        String   @id @default(cuid())
  /// slug (a-z0-9_-); the model sees tools as mcp__<name>__<tool>.
  name      String   @unique
  url       String
  transport String   @default("http") // AI_MCP_TRANSPORTS
  /// Encrypted JSON object of HTTP headers (e.g. Authorization), or null.
  headers   String?
  mode      String   @default("APPROVAL") // AI_MCP_MODES
  minRole   String   @default("AGENT") // ROLES
  enabled   Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

/// A persisted standalone Sable conversation (the /assistant surface). Reopenable,
/// listed in the left rail, auto-titled from the first user message. Distinct
/// from ticket-bound chat, which is ephemeral.
model AiConversation {
  id        String   @id @default(cuid())
  userId    String
  title     String   @default("New chat")
  scope     String   @default("GENERAL") // GENERAL | ADMIN (legacy behaviour hint; admin ops are now per-op RBAC-gated)
  archived  Boolean  @default(false)
  folderId  String? // optional grouping folder (SetNull on folder delete)
  projectId String? // optional Sable project this chat belongs to (SetNull on project delete)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user              User                 @relation("AiConversationUser", fields: [userId], references: [id], onDelete: Cascade)
  folder            AiFolder?            @relation(fields: [folderId], references: [id], onDelete: SetNull)
  project           AiProject?           @relation(fields: [projectId], references: [id], onDelete: SetNull)
  messages          AiMessage[]
  proposalDecisions AiProposalDecision[]

  @@index([userId, archived, updatedAt])
  @@index([folderId])
  @@index([projectId])
}

/// A per-user folder to organise Sable conversations. Deleting a folder just
/// un-groups its chats (SetNull) — it never deletes conversations.
model AiFolder {
  id        String   @id @default(cuid())
  userId    String
  name      String   @default("New folder")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  conversations AiConversation[]

  @@index([userId, updatedAt])
}

/// One turn in an AiConversation. role is a String-backed enum. toolCalls and
/// proposals are JSON strings (assistant turns only; null otherwise).
model AiMessage {
  id             String   @id @default(cuid())
  conversationId String
  role           String // "user" | "assistant"
  content        String   @default("")
  html           String? // sanitized markdown HTML for assistant turns
  toolCalls      String? // JSON string: {name,input}[]
  proposals      String? // JSON string: AssistantProposal[]
  createdAt      DateTime @default(now())

  conversation AiConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
}

/// The user's decision on one of Sable's approve-first proposals, keyed by the
/// tool call that made it plus a signature of its operation and parsed args. The
/// unique key makes Approve a claim, so a proposal is applied at most once (double
/// click, second tab, reload), and lets a reloaded chat show each card as
/// pending, applied or gone.
model AiProposalDecision {
  id             String   @id @default(cuid())
  conversationId String
  proposalKey    String
  status         String // APPLYING | APPLIED | DISMISSED
  claimId        String? // token of the request holding an APPLYING claim
  summary        String? // the applied operation's result line
  decidedById    String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  conversation AiConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@unique([conversationId, proposalKey])
}

/// A persistent Sable workspace: owns conversations, a foldered file library,
/// custom instructions, and an optional ITSM binding (Change / Problem / Ticket).
/// Personal by default; optionally shared with a team (mirrors SavedView sharing).
model AiProject {
  id           String  @id @default(cuid())
  userId       String // owner
  name         String  @default("New project")
  description  String?
  instructions String? // injected verbatim into every system prompt for this project
  archived     Boolean @default(false)

  isShared Boolean @default(false) // visible to the shared group's members
  groupId  String? // optional team the project is shared with (SetNull on group delete)

  // Optional ITSM binding — the differentiator. Any subset may be set.
  changeId  Int?
  problemId Int?
  ticketId  Int?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user          User              @relation("AiProjectOwner", fields: [userId], references: [id], onDelete: Cascade)
  group         Group?            @relation("AiProjectGroup", fields: [groupId], references: [id], onDelete: SetNull)
  change        Change?           @relation(fields: [changeId], references: [id], onDelete: SetNull)
  problem       Problem?          @relation(fields: [problemId], references: [id], onDelete: SetNull)
  ticket        Ticket?           @relation(fields: [ticketId], references: [id], onDelete: SetNull)
  conversations AiConversation[]
  folders       AiProjectFolder[]
  files         AiProjectFile[]

  @@index([userId, archived, updatedAt])
  @@index([groupId])
  @@index([changeId])
  @@index([problemId])
  @@index([ticketId])
}

/// A folder inside a project's file library (structure for docs). Self-nesting;
/// deleting a folder un-nests its children/files (SetNull), never deletes blobs.
model AiProjectFolder {
  id        String   @id @default(cuid())
  projectId String
  parentId  String? // nested folders
  name      String   @default("New folder")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  project  AiProject         @relation(fields: [projectId], references: [id], onDelete: Cascade)
  parent   AiProjectFolder?  @relation("AiProjectFolderTree", fields: [parentId], references: [id], onDelete: SetNull)
  children AiProjectFolder[] @relation("AiProjectFolderTree")
  files    AiProjectFile[]

  @@index([projectId])
  @@index([parentId])
}

/// A file in a project's library. Bytes live in blob storage (the linked
/// Attachment row + lib/storage.ts); this row adds project structure and the
/// server-extracted text used for retrieval.
model AiProjectFile {
  id            String    @id @default(cuid())
  projectId     String
  folderId      String? // null = project root
  attachmentId  String    @unique // the blob (reuses Attachment + lib/storage.ts)
  name          String
  extractedText String? // server-side text extraction for retrieval (phase 2)
  tag           String? // auto-classified content type (Documentation | Email | Spreadsheet | Presentation | Image | Contract | Report | Note | Other)
  indexedAt     DateTime?
  createdAt     DateTime  @default(now())

  project    AiProject        @relation(fields: [projectId], references: [id], onDelete: Cascade)
  folder     AiProjectFolder? @relation(fields: [folderId], references: [id], onDelete: SetNull)
  attachment Attachment       @relation("AiProjectFileBlob", fields: [attachmentId], references: [id], onDelete: Cascade)
  chunks     AiProjectChunk[]

  @@index([projectId, folderId])
}

/// Retrieval chunks of a project file. Phase 2 uses full-text (LIKE/tsvector);
/// a later phase can add an embedding column (Postgres/pgvector) additively.
model AiProjectChunk {
  id        String   @id @default(cuid())
  fileId    String
  projectId String // denormalised for cheap project-scoped filtering
  ord       Int
  text      String
  createdAt DateTime @default(now())

  file AiProjectFile @relation(fields: [fileId], references: [id], onDelete: Cascade)

  @@index([projectId])
  @@index([fileId, ord])
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ---------------------------------------------------------------------------
// Organisation: groups
// ---------------------------------------------------------------------------

model Group {
  id                 String   @id @default(cuid())
  name               String   @unique
  description        String?
  type               String   @default("TEAM") // TEAM | DEPARTMENT | VENDOR
  email              String?
  color              String   @default("#6366f1")
  managerId          String?
  autoAssign         String   @default("OFF") // OFF | ROUND_ROBIN | LEAST_BUSY
  lastAssignedUserId String? // round-robin cursor (indexed for the assign lookup)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  manager           User?                @relation("GroupManager", fields: [managerId], references: [id])
  members           GroupMember[]
  tickets           Ticket[]
  problems          Problem[]
  changes           Change[]
  assets            Asset[]
  savedViews        SavedView[]
  dashboards        Dashboard[]
  ownedCategories   Category[]           @relation("CategoryTeam")
  ownedServices     Service[]            @relation("ServiceTeam")
  ownedCatalogItems CatalogItem[]        @relation("CatalogItemTeam")
  catalogVisibility CatalogItemGroup[]
  aiProjects        AiProject[]          @relation("AiProjectGroup")
  freezeWindows     ChangeFreezeWindow[]
  onCallSchedules   OnCallSchedule[]
  releases          Release[]
  changeTemplates   ChangeTemplate[]
  recurringTickets  RecurringTicket[]
}

/// A named, saved set of list filters (per-user, optionally shared with a team).
/// `filters` is a JSON object of URL params (status, priority, type, group, …).
model SavedView {
  id        String   @id @default(cuid())
  name      String
  entity    String   @default("ticket") // ticket | problem | change | asset
  filters   String // JSON map of filter params
  ownerId   String
  isShared  Boolean  @default(false) // visible to the owner's team(s)
  groupId   String? // optional: scope a shared view to one team
  order     Int      @default(0)
  createdAt DateTime @default(now())

  owner User   @relation("SavedViewOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  group Group? @relation(fields: [groupId], references: [id])

  @@index([entity])
  @@index([ownerId])
}

/// A customizable dashboard: a JSON `layout` of widgets on a 12-col grid.
/// Personal by default; managers/admins can share one with a team or the org.
model Dashboard {
  id        String   @id @default(cuid())
  name      String
  ownerId   String
  isShared  Boolean  @default(false)
  groupId   String?
  layout    String   @default("[]") // JSON: Widget[]
  order     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  owner User   @relation("DashboardOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  group Group? @relation(fields: [groupId], references: [id])

  @@index([ownerId])
}

model GroupMember {
  id      String @id @default(cuid())
  groupId String
  userId  String
  role    String @default("MEMBER") // MEMBER | LEAD
  group   Group  @relation(fields: [groupId], references: [id], onDelete: Cascade)
  user    User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([groupId, userId])
}

// ---------------------------------------------------------------------------
// Catalog: categories, services, SLAs
// ---------------------------------------------------------------------------

model Category {
  id           String  @id @default(cuid())
  name         String
  description  String?
  icon         String?
  color        String  @default("#64748b")
  parentId     String?
  groupId      String? // team that handles this category; default group of API-created tickets
  archived     Boolean @default(false) // hidden from pickers/portal; existing tickets keep it
  portalHidden Boolean @default(false) // staff-only (e.g. monitoring): not offered in the self-service portal

  parent           Category?         @relation("CategoryTree", fields: [parentId], references: [id])
  children         Category[]        @relation("CategoryTree")
  group            Group?            @relation("CategoryTeam", fields: [groupId], references: [id])
  tickets          Ticket[]
  problems         Problem[]
  changes          Change[]
  services         Service[]
  articles         Article[]
  catalogItems     CatalogItem[]
  changeTemplates  ChangeTemplate[]
  recurringTickets RecurringTicket[]

  @@unique([name, parentId])
  @@index([parentId])
}

model SLA {
  id           String  @id @default(cuid())
  name         String  @unique
  description  String?
  priority     String? // matches ticket priority for auto-assignment
  responseMins Int     @default(60)
  resolveMins  Int     @default(480)
  isActive     Boolean @default(true)

  businessCalendarId String? // optional working-hours calendar the SLA clock honours (null = 24/7)
  escalationPolicyId String? // optional escalation policy fired as the clock elapses

  businessCalendar BusinessCalendar? @relation(fields: [businessCalendarId], references: [id])
  escalationPolicy EscalationPolicy? @relation(fields: [escalationPolicyId], references: [id])
  services         Service[]
  tickets          Ticket[]

  @@index([businessCalendarId])
  @@index([escalationPolicyId])
}

// ---------------------------------------------------------------------------
// Business calendars & escalation (SLA working hours + tiered escalation)
// ---------------------------------------------------------------------------

/// A named working-hours calendar the SLA clock honours. `weeklyHours` is a JSON
/// object of per-weekday open/close windows (e.g. {"mon":[["09:00","17:00"]], …}).
model BusinessCalendar {
  id          String   @id @default(cuid())
  name        String
  timezone    String   @default("UTC")
  weeklyHours String   @default("{}") // JSON: per-weekday open/close windows
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  holidays Holiday[]
  slas     SLA[]
}

/// A single non-working day on a BusinessCalendar (the SLA clock pauses on it).
model Holiday {
  id         String   @id @default(cuid())
  calendarId String
  date       DateTime
  name       String

  calendar BusinessCalendar @relation(fields: [calendarId], references: [id], onDelete: Cascade)

  @@index([calendarId])
}

/// A named, ordered set of escalation steps applied as an SLA clock elapses.
model EscalationPolicy {
  id        String   @id @default(cuid())
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  steps EscalationStep[]
  slas  SLA[]
}

/// One escalation step: at `thresholdPercent` of SLA elapsed, run `action`.
model EscalationStep {
  id               String  @id @default(cuid())
  policyId         String
  order            Int     @default(0)
  thresholdPercent Int     @default(100) // % of SLA elapsed that triggers it (e.g. 50/75/100)
  action           String // NOTIFY | REASSIGN | BUMP_PRIORITY | NOTIFY_ONCALL | REASSIGN_ONCALL (*_ONCALL target whoever is on call for the ticket's group)
  targetGroupId    String? // group to reassign/notify
  targetUserId     String? // user to reassign/notify
  bumpToPriority   String? // priority to bump to (for BUMP_PRIORITY)

  policy EscalationPolicy @relation(fields: [policyId], references: [id], onDelete: Cascade)

  @@index([policyId])
}

model Service {
  id          String   @id @default(cuid())
  name        String   @unique
  code        String?  @unique // short service number shown next to the name (e.g. "S-01")
  importRef   String?  @unique // origin key of a service maintained through the API (e.g. "catalog:mail"); PUT /api/v1/services/ref/{ref} upserts by it
  description String?
  status      String   @default("OPERATIONAL") // OPERATIONAL | DEGRADED | OUTAGE | MAINTENANCE | RETIRED
  criticality String   @default("MEDIUM") // LOW | MEDIUM | HIGH | CRITICAL
  icon        String?
  categoryId  String?
  ownerId     String?
  slaId       String?
  groupId     String? // team that runs this service (used to pre-route catalog requests)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  category         Category?               @relation(fields: [categoryId], references: [id])
  owner            User?                   @relation("ServiceOwner", fields: [ownerId], references: [id])
  sla              SLA?                    @relation(fields: [slaId], references: [id])
  group            Group?                  @relation("ServiceTeam", fields: [groupId], references: [id])
  tickets          Ticket[]
  catalogItems     CatalogItem[]
  assets           ServiceAsset[]
  freezeWindows    ChangeFreezeWindow[]
  statusIncidents  StatusIncidentService[]
  changeTemplates  ChangeTemplate[]
  recurringTickets RecurringTicket[]
  dependsOn        ServiceDependency[]     @relation("ServiceDependsOn")
  usedBy           ServiceDependency[]     @relation("ServiceUsedBy")
}

/// Service-to-service dependency: `fromService` DEPENDS_ON `toService`, so an outage of
/// `toService` affects `fromService`. Self-dependencies and cycles are refused by the writers
/// (lib/service-graph-rules.ts).
model ServiceDependency {
  id            String   @id @default(cuid())
  fromServiceId String
  toServiceId   String
  note          String?
  createdAt     DateTime @default(now())

  fromService Service @relation("ServiceDependsOn", fields: [fromServiceId], references: [id], onDelete: Cascade)
  toService   Service @relation("ServiceUsedBy", fields: [toServiceId], references: [id], onDelete: Cascade)

  @@unique([fromServiceId, toServiceId])
  @@index([toServiceId])
}

model CatalogItem {
  id               String   @id @default(cuid())
  name             String
  description      String?
  shortDescription String?
  icon             String?
  categoryId       String?
  serviceId        String? // the service this request maps to (pre-routes the ticket)
  groupId          String? // team requests of this item are routed to; null = the service's team, else the category's, else triage
  formSchema       String   @default("[]") // JSON: array of form field definitions
  ticketType       String   @default("REQUEST") // REQUEST | INCIDENT — what a request of this item becomes
  titleTemplate    String? // ticket title with {{item}}, {{requester}}, {{<question key>}}; null = "<Item> request"
  requiresApproval Boolean  @default(false)
  approverId       String?
  approvalStages   String? // JSON: ordered array of stage descriptors {approverId?|groupId?}; approverId is the stage-0 fallback
  estimatedDays    Int?
  isPublished      Boolean  @default(true)
  order            Int      @default(0)
  restrictToGroups Boolean  @default(false) // true = only members of the groups in `visibleTo` see and may request it; fails closed (nobody) if every listed group was deleted
  importRef        String?  @unique // origin key of an item maintained through the API; PUT /api/v1/catalog-items/ref/{ref} upserts by it
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  category  Category?          @relation(fields: [categoryId], references: [id])
  service   Service?           @relation(fields: [serviceId], references: [id])
  group     Group?             @relation("CatalogItemTeam", fields: [groupId], references: [id], onDelete: SetNull)
  approver  User?              @relation("CatalogApprover", fields: [approverId], references: [id])
  tickets   Ticket[]
  visibleTo CatalogItemGroup[]

  @@index([isPublished])
}

// Who may see and request a restricted catalog item: members of any listed group (CatalogItem.restrictToGroups).
model CatalogItemGroup {
  catalogItemId String
  groupId       String

  catalogItem CatalogItem @relation(fields: [catalogItemId], references: [id], onDelete: Cascade)
  group       Group       @relation(fields: [groupId], references: [id], onDelete: Cascade)

  @@id([catalogItemId, groupId])
  @@index([groupId])
}

// ---------------------------------------------------------------------------
// Ticketing (incidents & requests)
// ---------------------------------------------------------------------------

model Ticket {
  id              Int     @id @default(autoincrement())
  title           String
  description     String  @default("") // plaintext twin
  descriptionHtml String? // sanitized rich-text HTML; null = plaintext-only
  type            String  @default("INCIDENT") // INCIDENT | REQUEST — freely switchable
  prefix          String  @default("INC") // human-ref prefix (INC/REQ), fixed at creation; stays stable when `type` changes
  status          String  @default("NEW") // NEW | OPEN | IN_PROGRESS | PENDING | ON_HOLD | RESOLVED | CLOSED | CANCELLED
  priority        String  @default("MEDIUM") // LOW | MEDIUM | HIGH | CRITICAL
  impact          String  @default("MEDIUM") // LOW | MEDIUM | HIGH
  urgency         String  @default("MEDIUM") // LOW | MEDIUM | HIGH
  source          String  @default("PORTAL") // PORTAL | SABLE | EMAIL | PHONE | API | AGENT | RECURRING
  isMajorIncident Boolean @default(false)
  pendingReason   String? // AWAITING_CUSTOMER | AWAITING_VENDOR | AWAITING_CHANGE | AWAITING_PARTS | SCHEDULED
  pendingNote     String?
  resolutionCode  String? // FIXED | WORKAROUND | NOT_REPRODUCIBLE | DUPLICATE | NO_ACTION
  resolutionNote  String?
  mergedIntoId    Int?
  parentId        Int? // parent ticket of a sub-ticket; cleared (SetNull) if the parent is deleted

  requesterId       String
  requestedByUserId String?
  assigneeId        String?
  groupId           String?
  categoryId        String?
  serviceId         String?
  catalogItemId     String?
  slaId             String?
  problemId         Int?
  changeId          Int?

  formData            String? // JSON answers when submitted from a catalog form
  formSchema          String? // snapshot of the catalog form schema at submit time (survives item deletion)
  customFields        String    @default("{}") // JSON object of custom-field key -> value (CustomFieldDef, entityType=TICKET)
  approvalState       String? // null | PENDING | APPROVED | REJECTED
  dueDate             DateTime? // manual due date set by an agent (distinct from the SLA clock)
  // ---- SLA clock (resolved from SLA/service/priority at create) ----
  dueAt               DateTime? // mirror of resolveDueAt (kept for existing views)
  responseDueAt       DateTime?
  resolveDueAt        DateTime?
  responseBreached    Boolean   @default(false)
  resolveBreached     Boolean   @default(false)
  pendingSince        DateTime? // set while PENDING/ON_HOLD so the clock can pause
  // Accumulated paused time in ms. Float, not Int: a 32-bit Int overflows after
  // ~24.8 days of pause, and BigInt would surface as JS `bigint` (breaks number
  // math and JSON.stringify). A double holds whole ms exactly up to 2^53.
  pausedMs            Float     @default(0)
  escalatedAt         DateTime? // set when SLA-breach escalation has fired (marker so it fires once)
  slaAtRiskNotifiedAt DateTime? // set when SLA-at-risk notification has fired (idempotency marker)
  slaNudgedAt         DateTime? // set when the assignee SLA nudge has fired (at-most-once marker, lib/ticks/sla-nudges.ts)
  firstResponseAt     DateTime?
  resolvedAt          DateTime?
  closedAt            DateTime?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt
  importRef           String?   @unique // origin of a record imported via POST /api/v1/import/tickets (e.g. "glpi:ticket:42")
  // Integration key of a monitoring alert (e.g. "zabbix:event:12345"), set via POST /api/v1/tickets. Kept for
  // good as history; `openExternalRef` mirrors it only while the ticket is open, so the unique index allows one
  // OPEN ticket per key (Prisma cannot express a partial unique index). lib/db.ts clears it on RESOLVED/CLOSED/CANCELLED.
  externalRef         String?
  openExternalRef     String?   @unique

  requester   User         @relation("TicketRequester", fields: [requesterId], references: [id])
  requestedBy User?        @relation("TicketRequestedBy", fields: [requestedByUserId], references: [id])
  assignee    User?        @relation("TicketAssignee", fields: [assigneeId], references: [id])
  group       Group?       @relation(fields: [groupId], references: [id])
  category    Category?    @relation(fields: [categoryId], references: [id])
  service     Service?     @relation(fields: [serviceId], references: [id])
  catalogItem CatalogItem? @relation(fields: [catalogItemId], references: [id])
  sla         SLA?         @relation(fields: [slaId], references: [id])
  problem     Problem?     @relation(fields: [problemId], references: [id])
  change      Change?      @relation(fields: [changeId], references: [id])

  comments         TicketComment[]
  watchers         TicketWatcher[]
  participants     TicketParticipant[]
  notifiedContacts TicketNotifiedContact[]
  emails           EmailMessage[]
  attachments      Attachment[]
  assets           TicketAsset[]
  tasks            Task[]
  worklogs         WorkLog[]
  approvals        TicketApproval[]
  survey           SurveyResponse?
  mergedInto       Ticket?                 @relation("TicketMerge", fields: [mergedIntoId], references: [id])
  mergedTickets    Ticket[]                @relation("TicketMerge")
  parent           Ticket?                 @relation("TicketParent", fields: [parentId], references: [id], onDelete: SetNull)
  children         Ticket[]                @relation("TicketParent")
  mergesAsSource   TicketMerge[]           @relation("MergeSource")
  mergesAsTarget   TicketMerge[]           @relation("MergeTarget")
  linksFrom        TicketLink[]            @relation("LinkSource")
  linksTo          TicketLink[]            @relation("LinkTarget")
  aiProjects       AiProject[]
  statusIncident   StatusIncident?
  aiInsights       AiInsightTicket[]

  @@index([status])
  @@index([priority])
  @@index([assigneeId])
  @@index([requesterId])
  @@index([requestedByUserId])
  @@index([groupId])
  @@index([parentId])
  @@index([createdAt])
  @@index([resolvedAt])
  @@index([resolveDueAt])
  @@index([updatedAt])
  @@index([serviceId])
  @@index([categoryId])
  @@index([slaId])
  @@index([problemId])
  @@index([changeId])
  @@index([mergedIntoId])
  @@index([externalRef])
}

model TicketComment {
  id             String   @id @default(cuid())
  ticketId       Int
  authorId       String
  body           String // plaintext twin (search / notifications / mentions)
  bodyHtml       String? // sanitized rich-text HTML; null = legacy plaintext row
  isInternal     Boolean  @default(false)
  channel        String   @default("WEB") // WEB | EMAIL | FORWARD — how this reply arrived
  fromEmail      String? // external sender address when it came in via email
  emailMessageId String? // link to the inbound EmailMessage that produced it
  createdAt      DateTime @default(now())
  importRef      String? // source id of a comment written by the history import (unique per ticket; dedup on re-runs)

  ticket      Ticket       @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  author      User         @relation(fields: [authorId], references: [id])
  attachments Attachment[]

  @@unique([ticketId, importRef])
  @@index([ticketId])
}

model Task {
  id         String   @id @default(cuid())
  ticketId   Int
  title      String
  done       Boolean  @default(false)
  order      Int      @default(0)
  assigneeId String?
  createdAt  DateTime @default(now())

  ticket   Ticket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  assignee User?  @relation(fields: [assigneeId], references: [id])

  @@index([ticketId])
}

// Time/effort logged against a ticket (drives effort reporting).
model WorkLog {
  id        String   @id @default(cuid())
  ticketId  Int
  userId    String
  minutes   Int
  note      String?
  billable  Boolean  @default(false)
  loggedAt  DateTime @default(now())
  createdAt DateTime @default(now())

  ticket Ticket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id])

  @@index([ticketId])
}

/// One ticket merge, with what is needed to undo it: the source's pre-merge state and the
/// records that were copied onto the target (JSON arrays of ids).
model TicketMerge {
  id                    String    @id @default(cuid())
  sourceId              Int
  targetId              Int
  mergedById            String?
  previousStatus        String
  previousClosedAt      DateTime?
  previousApprovalState String?
  copiedCommentIds      String    @default("[]") // JSON array of TicketComment ids created on the target
  copiedWatcherIds      String    @default("[]") // JSON array of user ids added as watchers on the target
  copiedAssetIds        String    @default("[]") // JSON array of asset ids linked to the target
  movedAttachments      String    @default("[]") // JSON array of {id, commentId}: Attachments re-pointed to the target (commentId = the source comment they hung on, null for ticket-level files)
  copiedLinkIds         String    @default("[]") // JSON array of TicketLink ids created for the target
  movedChildIds         String    @default("[]") // JSON array of ticket ids re-parented from the source to the target
  withdrawnApprovalIds  String    @default("[]") // JSON array of TicketApproval ids that were PENDING on the source and got cancelled
  adoptedProblemId      Int? // problemId the target took over from the source (it had none)
  adoptedChangeId       Int? // changeId the target took over from the source (it had none)
  createdAt             DateTime  @default(now())
  undoneAt              DateTime?
  undoneById            String?

  source   Ticket @relation("MergeSource", fields: [sourceId], references: [id], onDelete: Cascade)
  target   Ticket @relation("MergeTarget", fields: [targetId], references: [id], onDelete: Cascade)
  mergedBy User?  @relation("TicketMergedBy", fields: [mergedById], references: [id], onDelete: SetNull)
  undoneBy User?  @relation("TicketMergeUndoneBy", fields: [undoneById], references: [id], onDelete: SetNull)

  @@index([sourceId])
  @@index([targetId])
}

model TicketLink {
  id             String   @id @default(cuid())
  ticketId       Int
  linkedTicketId Int
  type           String   @default("RELATED") // RELATED | DUPLICATE | BLOCKS | CAUSED_BY
  createdAt      DateTime @default(now())

  ticket Ticket @relation("LinkSource", fields: [ticketId], references: [id], onDelete: Cascade)
  linked Ticket @relation("LinkTarget", fields: [linkedTicketId], references: [id], onDelete: Cascade)

  @@unique([ticketId, linkedTicketId])
}

model TicketApproval {
  id         String    @id @default(cuid())
  ticketId   Int
  approverId String
  status     String    @default("PENDING") // PENDING | APPROVED | REJECTED
  stage      Int       @default(0) // multi-stage catalog approvals (stage 0 = first)
  comment    String?
  decidedAt  DateTime?
  createdAt  DateTime  @default(now())

  ticket   Ticket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  approver User   @relation("TicketApprover", fields: [approverId], references: [id])

  @@index([approverId, status])
}

/// A post-resolution CSAT survey for a ticket. One per ticket; `token` gates the
/// public response link. `rating` is on the SURVEY_RATING_MIN..MAX scale.
model SurveyResponse {
  id          String    @id @default(cuid())
  ticketId    Int       @unique
  token       String    @unique
  rating      Int? // SURVEY_RATING_MIN..SURVEY_RATING_MAX
  comment     String?
  sentAt      DateTime  @default(now())
  respondedAt DateTime?

  ticket Ticket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
}

/// A reusable set of ordered ticket actions an agent can apply in one click.
/// `actions` is a JSON array of ordered {type,value} steps. Personal by default;
/// `isShared` exposes it to the whole team.
model Macro {
  id          String   @id @default(cuid())
  name        String
  description String?
  actions     String   @default("[]") // JSON: ordered array of {type,value}
  ownerId     String?
  isShared    Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  owner User? @relation("MacroOwner", fields: [ownerId], references: [id])

  @@index([ownerId])
}

// Internal followers: agents who "watch" a ticket for in-app notifications.
model TicketWatcher {
  ticketId Int
  userId   String
  ticket   Ticket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  user     User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([ticketId, userId])
}

// Customer-side collaborators (e.g. a requester's manager CC'd on the request).
// DISTINCT from a watcher: a participant can SEE and REPLY to the ticket in the
// self-service PORTAL and is CC'd on customer-facing emails.
model TicketParticipant {
  ticketId  Int
  userId    String
  addedById String?
  createdAt DateTime @default(now())
  ticket    Ticket   @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  user      User     @relation("TicketParticipantUser", fields: [userId], references: [id], onDelete: Cascade)

  @@id([ticketId, userId])
  @@index([userId])
}

// External parties a ticket was forwarded to ("Notified"). NOT participants: they
// have no portal access, and their email replies land as INTERNAL comments.
model TicketNotifiedContact {
  id           String   @id @default(cuid())
  ticketId     Int
  email        String
  name         String?
  notifiedById String?
  createdAt    DateTime @default(now())
  ticket       Ticket   @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  notifiedBy   User?    @relation("TicketNotifiedBy", fields: [notifiedById], references: [id])

  @@unique([ticketId, email])
  @@index([ticketId])
}

// ---------------------------------------------------------------------------
// Problem management
// ---------------------------------------------------------------------------

model Problem {
  id              Int       @id @default(autoincrement())
  title           String
  description     String    @default("") // plaintext twin
  descriptionHtml String? // sanitized rich-text HTML
  status          String    @default("NEW") // NEW | INVESTIGATING | KNOWN_ERROR | RESOLVED | CLOSED
  priority        String    @default("MEDIUM")
  impact          String    @default("MEDIUM")
  rootCause       String?
  workaround      String?
  customFields    String    @default("{}") // JSON object of custom-field key -> value (CustomFieldDef, entityType=PROBLEM)
  assigneeId      String?
  groupId         String?
  categoryId      String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  resolvedAt      DateTime?
  importRef       String?   @unique // origin of a record imported via POST /api/v1/import/problems

  assignee    User?            @relation("ProblemAssignee", fields: [assigneeId], references: [id])
  group       Group?           @relation(fields: [groupId], references: [id])
  category    Category?        @relation(fields: [categoryId], references: [id])
  tickets     Ticket[]
  changes     Change[]
  comments    ProblemComment[]
  attachments Attachment[]
  aiProjects  AiProject[]
  aiInsights  AiInsight[]

  @@index([status])
}

model ProblemComment {
  id         String   @id @default(cuid())
  problemId  Int
  authorId   String
  body       String
  bodyHtml   String?
  isInternal Boolean  @default(false)
  createdAt  DateTime @default(now())
  importRef  String? // source id of a comment written by the history import (unique per problem; dedup on re-runs)

  problem Problem @relation(fields: [problemId], references: [id], onDelete: Cascade)
  author  User    @relation(fields: [authorId], references: [id])

  @@unique([problemId, importRef])
  @@index([problemId])
}

// ---------------------------------------------------------------------------
// Change management
// ---------------------------------------------------------------------------

model Change {
  id                 Int       @id @default(autoincrement())
  title              String
  description        String    @default("") // plaintext twin
  descriptionHtml    String? // sanitized rich-text HTML
  type               String    @default("NORMAL") // STANDARD | NORMAL | EMERGENCY
  status             String    @default("DRAFT") // DRAFT | APPROVAL | APPROVED | SCHEDULED | IN_PROGRESS | REVIEW | CLOSED | REJECTED | FAILED | CANCELLED
  risk               String    @default("MEDIUM") // LOW | MEDIUM | HIGH
  priority           String    @default("MEDIUM")
  impact             String    @default("MEDIUM")
  reason             String?
  implementationPlan String?
  rollbackPlan       String?
  outcome            String? // SUCCESSFUL | SUCCESSFUL_WITH_ISSUES | FAILED | ROLLED_BACK — set when the change is reviewed/closed
  closureNotes       String? // post-implementation review / lessons learned
  cancelReason       String? // why the change was cancelled (status CANCELLED)
  approvalRule       String    @default("UNANIMOUS") // UNANIMOUS | QUORUM | PERCENT — how CAB approvals resolve
  approvalThreshold  Int? // N for QUORUM, or percent for PERCENT
  customFields       String    @default("{}") // JSON object of custom-field key -> value (CustomFieldDef, entityType=CHANGE)
  assigneeId         String?
  createdById        String?
  groupId            String?
  categoryId         String?
  problemId          Int?
  releaseId          Int? // the Release this change ships in (SetNull when the release is deleted)
  templateId         String? // the ChangeTemplate it was created from (traceability; SetNull on template delete)
  plannedStart       DateTime?
  plannedEnd         DateTime?
  actualStart        DateTime?
  actualEnd          DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
  importRef          String?   @unique // origin of a record imported via POST /api/v1/import/changes (e.g. "glpi:change:129")

  assignee    User?            @relation("ChangeAssignee", fields: [assigneeId], references: [id])
  createdBy   User?            @relation("ChangeCreatedBy", fields: [createdById], references: [id])
  group       Group?           @relation(fields: [groupId], references: [id])
  category    Category?        @relation(fields: [categoryId], references: [id])
  problem     Problem?         @relation(fields: [problemId], references: [id])
  release     Release?         @relation(fields: [releaseId], references: [id], onDelete: SetNull)
  template    ChangeTemplate?  @relation(fields: [templateId], references: [id], onDelete: SetNull)
  approvals   ChangeApproval[]
  assets      ChangeAsset[]
  tickets     Ticket[]
  comments    ChangeComment[]
  attachments Attachment[]
  aiProjects  AiProject[]

  @@index([status])
  @@index([releaseId])
  @@index([plannedStart, plannedEnd])
}

model ChangeComment {
  id         String   @id @default(cuid())
  changeId   Int
  authorId   String
  body       String
  bodyHtml   String?
  isInternal Boolean  @default(false)
  createdAt  DateTime @default(now())
  importRef  String? // source id of a comment written by the history import (unique per change; dedup on re-runs)

  change Change @relation(fields: [changeId], references: [id], onDelete: Cascade)
  author User   @relation(fields: [authorId], references: [id])

  @@unique([changeId, importRef])
  @@index([changeId])
}

model ChangeApproval {
  id         String    @id @default(cuid())
  changeId   Int
  approverId String
  status     String    @default("PENDING") // PENDING | APPROVED | REJECTED | CANCELLED (withdrawn)
  comment    String?
  decidedAt  DateTime?
  createdAt  DateTime  @default(now())

  change   Change @relation(fields: [changeId], references: [id], onDelete: Cascade)
  approver User   @relation(fields: [approverId], references: [id])

  @@unique([changeId, approverId])
}

// ---------------------------------------------------------------------------
// Custom fields — admin-defined extra fields on tickets/problems/changes.
// Values live in each entity's `customFields` JSON (fieldKey -> value).
// `visibility` reuses the automation condition shape ({field,op,value}).
// ---------------------------------------------------------------------------

model CustomFieldDef {
  id          String   @id @default(cuid())
  entityType  String // TICKET | PROBLEM | CHANGE
  key         String // stable key used inside the entity's customFields JSON
  label       String
  type        String // text | textarea | select | number | date | checkbox
  options     String   @default("[]") // JSON array of choice strings (for select)
  required    Boolean  @default(false)
  placeholder String?
  help        String?
  matchType   String   @default("ALL") // ALL | ANY — how visibility conditions combine
  visibility  String   @default("[]") // JSON array of {field,op,value} conditions (automation shape)
  order       Int      @default(0)
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([entityType, key])
  @@index([entityType])
}

/// An admin override on the built-in status lifecycle. A row exists ONLY to
/// change the default for one (entityType, from → to) transition: disable it
/// (`allowed=false`) or gate it behind a role (`requiredRole`). No row ⇒ the
/// built-in default (allowed, any agent). See lib/workflow.ts.
model StatusTransition {
  id           String   @id @default(cuid())
  entityType   String // TICKET | PROBLEM | CHANGE
  fromStatus   String
  toStatus     String
  allowed      Boolean  @default(true)
  requiredRole String? // null = any agent | MANAGER | ADMIN
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@unique([entityType, fromStatus, toStatus])
  @@index([entityType])
}

// ---------------------------------------------------------------------------
// Generic ad-hoc approvals
// ---------------------------------------------------------------------------

/// A polymorphic, manually-requested approval that can hang off ANY entity
/// (Ticket, Problem, Change, Service). Distinct from the two automated flows —
/// the Change CAB (ChangeApproval) and catalog approvals (TicketApproval) —
/// which stay as-is. This one is governance/sign-off: it records a decision,
/// notifies, and drops an audit trail, but never drives the entity lifecycle.
model Approval {
  id            String    @id @default(cuid())
  entityType    String // TICKET | PROBLEM | CHANGE | SERVICE
  entityId      String // stringified entity id (Int entities stored as text)
  title         String    @default("") // what is being approved (free text)
  approverId    String
  requestedById String?
  status        String    @default("PENDING") // PENDING | APPROVED | REJECTED
  comment       String?
  decidedAt     DateTime?
  createdAt     DateTime  @default(now())

  approver    User  @relation("ApprovalApprover", fields: [approverId], references: [id])
  requestedBy User? @relation("ApprovalRequester", fields: [requestedById], references: [id])

  @@unique([entityType, entityId, approverId])
  @@index([entityType, entityId])
  @@index([approverId, status])
}

// ---------------------------------------------------------------------------
// Assets / CMDB
// ---------------------------------------------------------------------------

model Asset {
  id           String    @id @default(cuid())
  assetTag     String?   @unique
  name         String
  type         String    @default("SERVER") // SERVER | WORKSTATION | LAPTOP | NETWORK | SOFTWARE | MOBILE | PRINTER | VM | CLOUD | SERVICE | MONITOR | PHONE
  status       String    @default("IN_USE") // IN_USE | IN_STOCK | MAINTENANCE | RETIRED | DISPOSED
  serial       String?
  model        String?
  manufacturer String?
  location     String?
  locationId   String?
  ipAddress    String?
  macAddress   String?
  os           String?
  cpu          String?
  ramGb        Int?
  storageGb    Int?
  cost         Float?
  purchaseDate DateTime?
  warrantyEnd  DateTime?
  notes        String?
  ownerId      String?
  groupId      String?
  syncSourceId String?
  externalId   String?
  lastSeenAt   DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  importRef    String?   @unique // origin key of an asset written via the API (e.g. "glpi:computer:12", "inventory:host:pc-042"); PUT /api/v1/assets/ref/{ref} upserts by it

  owner              User?               @relation("AssetOwner", fields: [ownerId], references: [id])
  group              Group?              @relation(fields: [groupId], references: [id])
  locationRef        Location?           @relation(fields: [locationId], references: [id])
  syncSource         SyncSource?         @relation(fields: [syncSourceId], references: [id])
  relationsFrom      AssetRelation[]     @relation("RelationSource")
  relationsTo        AssetRelation[]     @relation("RelationTarget")
  tickets            TicketAsset[]
  changes            ChangeAsset[]
  services           ServiceAsset[]
  contracts          ContractAsset[]
  licenseAssignments LicenseAssignment[]
  attachments        Attachment[]

  @@unique([syncSourceId, externalId])
  @@index([type])
  @@index([status])
  @@index([syncSourceId])
}

model Location {
  id        String   @id @default(cuid())
  name      String
  type      String   @default("BUILDING") // SITE | BUILDING | FLOOR | ROOM | DATACENTER | RACK
  parentId  String?
  address   String?
  city      String?
  country   String?
  notes     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  parent   Location?  @relation("LocationTree", fields: [parentId], references: [id])
  children Location[] @relation("LocationTree")
  assets   Asset[]

  @@index([parentId])
}

model AssetRelation {
  id       String @id @default(cuid())
  sourceId String
  targetId String
  type     String @default("DEPENDS_ON") // DEPENDS_ON | CONNECTS_TO | RUNS_ON | HOSTS | PART_OF | BACKS_UP

  source Asset @relation("RelationSource", fields: [sourceId], references: [id], onDelete: Cascade)
  target Asset @relation("RelationTarget", fields: [targetId], references: [id], onDelete: Cascade)

  @@unique([sourceId, targetId, type])
  @@index([sourceId])
  @@index([targetId])
}

model TicketAsset {
  ticketId Int
  assetId  String
  ticket   Ticket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  asset    Asset  @relation(fields: [assetId], references: [id], onDelete: Cascade)

  @@id([ticketId, assetId])
}

model ChangeAsset {
  changeId Int
  assetId  String
  change   Change @relation(fields: [changeId], references: [id], onDelete: Cascade)
  asset    Asset  @relation(fields: [assetId], references: [id], onDelete: Cascade)

  @@id([changeId, assetId])
}

/// Configuration items a Service runs on / depends on (CMDB service mapping).
model ServiceAsset {
  serviceId String
  assetId   String
  createdAt DateTime @default(now())
  service   Service  @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  asset     Asset    @relation(fields: [assetId], references: [id], onDelete: Cascade)

  @@id([serviceId, assetId])
}

// ---------------------------------------------------------------------------
// Attachments
// ---------------------------------------------------------------------------

model Attachment {
  id           String   @id @default(cuid())
  filename     String
  url          String? // legacy/external only; new uploads use storageKey
  storageKey   String? // driver-agnostic blob key (YYYY/MM/<id>-<name>)
  checksum     String? // hex sha256 of the blob
  mime         String   @default("application/octet-stream")
  size         Float    @default(0) // bytes; Float because Int caps at 2 GiB (MAX_UPLOAD_MB is admin-settable)
  ticketId     Int?
  commentId    String?
  articleId    String?
  changeId     Int?
  problemId    Int?
  assetId      String?
  licenseId    String?
  uploadedById String?
  importRef    String?  @unique // source id of a file written by a history import (e.g. "glpi:document:42"); a re-upload with the same ref returns the stored file
  createdAt    DateTime @default(now())

  ticket        Ticket?          @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  comment       TicketComment?   @relation(fields: [commentId], references: [id], onDelete: Cascade)
  article       Article?         @relation(fields: [articleId], references: [id], onDelete: Cascade)
  change        Change?          @relation(fields: [changeId], references: [id], onDelete: Cascade)
  problem       Problem?         @relation(fields: [problemId], references: [id], onDelete: Cascade)
  asset         Asset?           @relation(fields: [assetId], references: [id], onDelete: Cascade)
  license       SoftwareLicense? @relation(fields: [licenseId], references: [id], onDelete: Cascade)
  uploadedBy    User?            @relation("AttachmentUploader", fields: [uploadedById], references: [id])
  aiProjectFile AiProjectFile?   @relation("AiProjectFileBlob")

  @@index([ticketId])
  @@index([commentId])
  @@index([articleId])
  @@index([changeId])
  @@index([problemId])
  @@index([assetId])
  @@index([licenseId])
  @@index([uploadedById])
  @@index([storageKey])
}

// ---------------------------------------------------------------------------
// Sync / integrations between infrastructures
// ---------------------------------------------------------------------------

model SyncSource {
  id         String    @id @default(cuid())
  name       String    @unique
  type       String    @default("LDAP") // LDAP | ACTIVE_DIRECTORY | AZURE_AD | INTUNE | CSV | SNOW | REST_API | GLPI
  direction  String    @default("IMPORT") // IMPORT | EXPORT | BIDIRECTIONAL
  scope      String    @default("ASSETS") // USERS | ASSETS | TICKETS | ALL
  config     String    @default("{}") // JSON blob (host, baseDN, mapping, etc.)
  schedule   String? // cron expression
  isActive   Boolean   @default(true)
  lastRunAt  DateTime?
  lastStatus String? // SUCCESS | FAILED | PARTIAL | RUNNING
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  runs   SyncRun[]
  users  User[]
  assets Asset[]
}

model SyncRun {
  id         String    @id @default(cuid())
  sourceId   String
  status     String    @default("RUNNING") // RUNNING | SUCCESS | FAILED | PARTIAL
  trigger    String    @default("MANUAL") // MANUAL | SCHEDULE | API
  created    Int       @default(0)
  updated    Int       @default(0)
  failed     Int       @default(0)
  log        String    @default("")
  startedAt  DateTime  @default(now())
  finishedAt DateTime?

  source SyncSource @relation(fields: [sourceId], references: [id], onDelete: Cascade)

  @@index([sourceId])
}

// ---------------------------------------------------------------------------
// API tokens, audit, notifications, knowledge base
// ---------------------------------------------------------------------------

model ApiToken {
  id         String    @id @default(cuid())
  name       String
  tokenHash  String    @unique
  prefix     String
  scopes     String    @default("read") // csv: read,write,admin
  userId     String
  lastUsedAt DateTime?
  expiresAt  DateTime?
  revoked    Boolean   @default(false)
  createdAt  DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model AuditLog {
  id        String   @id @default(cuid())
  userId    String?
  action    String // CREATE | UPDATE | DELETE | LOGIN | LOGIN_FAILED | SYNC | ...
  entity    String // Ticket | Asset | ...
  entityId  String
  summary   String?
  meta      String   @default("{}")
  ip        String?
  createdAt DateTime @default(now())

  user User? @relation(fields: [userId], references: [id])

  @@index([entity, entityId])
  @@index([userId, createdAt])
  @@index([action])
  @@index([createdAt])
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  type      String   @default("INFO")
  title     String
  body      String?
  entity    String?
  entityId  String?
  read      Boolean  @default(false)
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, read])
}

// Extra email addresses of a person (e.g. an alias or a second mailbox). Used to
// recognise inbound mail and thread replies; notifications still go to
// User.email. An address is unique across User.email and UserEmail.email —
// the cross-table half is enforced in lib/user-emails.ts.
model UserEmail {
  id        String   @id @default(cuid())
  userId    String
  email     String   @unique
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model EmailMessage {
  id         String    @id @default(cuid())
  direction  String    @default("OUTBOUND") // OUTBOUND | INBOUND
  toEmail    String
  toName     String?
  fromEmail  String? // inbound sender; outbound falls back to SMTP_FROM
  fromName   String?
  cc         String? // JSON array of addresses
  bcc        String? // JSON array of addresses
  replyTo    String?
  subject    String
  body       String // plaintext twin
  bodyHtml   String? // HTML variant (multipart/alternative)
  template   String    @default("generic")
  status     String    @default("QUEUED") // QUEUED | SENT | SIMULATED | FAILED | RECEIVED | REJECTED | ARCHIVED
  error      String? // outbound: delivery error; inbound: reject reason code or skipped attachments
  // ── RFC 2822 threading metadata (the load-bearing part of a real mail thread) ──
  messageId  String?   @unique // generated on send, captured on receive
  inReplyTo  String?
  references String? // full thread chain
  headers    String? // JSON: selected raw headers (debug / replay / loop-detection)
  entity     String?
  entityId   String?
  ticketId   Int? // direct FK (in addition to generic entity/entityId)
  commentId  String? // the TicketComment created from/for this mail
  createdAt  DateTime  @default(now())
  sentAt     DateTime?

  ticket Ticket? @relation(fields: [ticketId], references: [id], onDelete: SetNull)

  @@index([status])
  @@index([createdAt])
  @@index([ticketId])
  @@index([direction])
}

// Admin-editable email templates. A missing/disabled row falls back to the
// built-in default in lib/email-templates.ts, so mail never breaks. Body is HTML
// with {{placeholders}} resolved at send time; it is wrapped in the branded shell.
model EmailTemplate {
  key         String   @id // ticket_received | ticket_reply | ticket_resolved | ticket_assigned | ticket_participant
  subject     String
  bodyHtml    String
  enabled     Boolean  @default(true)
  updatedAt   DateTime @updatedAt
  updatedById String?

  updatedBy User? @relation(fields: [updatedById], references: [id])
}

model AutomationRule {
  id          String    @id @default(cuid())
  name        String
  description String?
  trigger     String    @default("TICKET_CREATED") // TICKET_CREATED | TICKET_UPDATED | TICKET_SLA_AT_RISK | TICKET_SLA_BREACHED
  matchType   String    @default("ALL") // ALL | ANY
  conditions  String    @default("[]") // JSON: [{ field, op, value }]
  actions     String    @default("[]") // JSON: [{ type, value }]
  isActive    Boolean   @default(true)
  order       Int       @default(0)
  runCount    Int       @default(0)
  lastRunAt   DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([trigger, isActive])
}

model Article {
  id           String    @id @default(cuid())
  title        String
  slug         String    @unique
  excerpt      String?
  body         String
  bodyFormat   String    @default("markdown") // markdown | plain
  status       String    @default("DRAFT") // DRAFT | REVIEW | PUBLISHED | RETIRED
  visibility   String    @default("INTERNAL") // INTERNAL (agents only) | PUBLIC (end-user portal)
  published    Boolean   @default(false) // denormalized mirror of (status === PUBLISHED)
  categoryId   String?
  authorId     String?
  approvedById String?
  views        Int       @default(0)
  importRef    String?   @unique // origin key of an article maintained through the API (e.g. "faq:vpn-setup"); PUT /api/v1/articles/ref/{ref} upserts by it
  publishedAt  DateTime?
  approvedAt   DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  category    Category?         @relation(fields: [categoryId], references: [id])
  author      User?             @relation(fields: [authorId], references: [id])
  approvedBy  User?             @relation("ArticleApprovedBy", fields: [approvedById], references: [id])
  revisions   ArticleRevision[]
  attachments Attachment[]
  links       ArticleLink[]
  aiInsights  AiInsight[]

  @@index([status, visibility])
}

/// A polymorphic link from a knowledge article to a Ticket, Problem or Change
/// (the article that helped resolve / explains it). Like Approval, entityId
/// points at the entity by id without a foreign key; the Int ids of those
/// entities are stored as-is, and links are cleaned up with the article.
model ArticleLink {
  id          String   @id @default(cuid())
  articleId   String
  entityType  String // TICKET | PROBLEM | CHANGE
  entityId    Int
  createdById String?
  createdAt   DateTime @default(now())

  article   Article @relation(fields: [articleId], references: [id], onDelete: Cascade)
  createdBy User?   @relation("ArticleLinkCreator", fields: [createdById], references: [id], onDelete: SetNull)

  @@unique([articleId, entityType, entityId])
  @@index([entityType, entityId])
}

// Append-only snapshot of an article's content, written on every save/publish.
model ArticleRevision {
  id        String   @id @default(cuid())
  articleId String
  version   Int
  title     String
  excerpt   String?
  body      String
  note      String?
  editorId  String?
  createdAt DateTime @default(now())

  article Article @relation(fields: [articleId], references: [id], onDelete: Cascade)
  editor  User?   @relation(fields: [editorId], references: [id])

  @@unique([articleId, version])
  @@index([articleId])
}

// ---------------------------------------------------------------------------
// Change schedule: freeze windows (change calendar)
// ---------------------------------------------------------------------------

/// A blackout period in which changes must not be planned. Global when neither
/// scope is set; otherwise it applies only when EVERY set scope matches the
/// change (serviceId: one of the change's affected CIs maps to that service via
/// ServiceAsset; groupId: Change.groupId). EMERGENCY changes may still be planned
/// inside it with a recorded justification (lib/change-schedule-rules.ts).
model ChangeFreezeWindow {
  id        String   @id @default(cuid())
  name      String
  reason    String?
  startsAt  DateTime
  endsAt    DateTime
  serviceId String? // optional scope: only changes whose CIs belong to this service
  groupId   String? // optional scope: only changes owned by this team
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  service Service? @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  group   Group?   @relation(fields: [groupId], references: [id], onDelete: Cascade)

  @@index([startsAt, endsAt])
  @@index([serviceId])
  @@index([groupId])
}

// ---------------------------------------------------------------------------
// On-call schedules (per team rotation + overrides)
// ---------------------------------------------------------------------------

/// A team's on-call rotation. Members take turns in `position` order; each shift
/// lasts one rotation interval (ONCALL_ROTATION_META[rotationType].hours, or
/// customIntervalHours for CUSTOM). `rotationStart` is the first handoff instant
/// (UTC; the UI derives it from a local date + `handoffTime` in `timezone`).
/// Resolved by lib/oncall-rules.ts; overrides always win.
model OnCallSchedule {
  id                  String   @id @default(cuid())
  name                String
  description         String?
  groupId             String
  timezone            String   @default("UTC") // IANA zone the handoff time is expressed in
  rotationType        String   @default("WEEKLY") // DAILY | WEEKLY | CUSTOM
  customIntervalHours Int? // shift length in hours when rotationType = CUSTOM
  handoffTime         String   @default("09:00") // HH:mm local handoff time (display + DST-correct re-anchoring)
  rotationStart       DateTime // first handoff instant (UTC); member at position 0 starts here
  isActive            Boolean  @default(true)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  group     Group            @relation(fields: [groupId], references: [id], onDelete: Cascade)
  members   OnCallMember[]
  overrides OnCallOverride[]

  @@index([groupId, isActive])
}

/// One person in a rotation, in `position` order (0 = first shift).
model OnCallMember {
  id         String @id @default(cuid())
  scheduleId String
  userId     String
  position   Int    @default(0)

  schedule OnCallSchedule @relation(fields: [scheduleId], references: [id], onDelete: Cascade)
  user     User           @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([scheduleId, userId])
  @@index([scheduleId, position])
  @@index([userId])
}

/// A time-boxed replacement: `userId` is on call for the schedule between
/// startsAt and endsAt, regardless of the rotation. `replacesUserId` records the
/// rotation member it stands in for (swaps), when known.
model OnCallOverride {
  id             String   @id @default(cuid())
  scheduleId     String
  userId         String
  replacesUserId String?
  startsAt       DateTime
  endsAt         DateTime
  reason         String?
  createdAt      DateTime @default(now())

  schedule OnCallSchedule @relation(fields: [scheduleId], references: [id], onDelete: Cascade)
  user     User           @relation("OnCallOverrideUser", fields: [userId], references: [id], onDelete: Cascade)
  replaces User?          @relation("OnCallOverrideReplaces", fields: [replacesUserId], references: [id], onDelete: SetNull)

  @@index([scheduleId, startsAt, endsAt])
  @@index([userId])
}

// ---------------------------------------------------------------------------
// Status page & major-incident communication
// ---------------------------------------------------------------------------

/// A service-status incident shown on the status page. Drafts are internal
/// (isPublic=false); only public incidents ever reach the portal or the portal
/// assistant. `ticketId` links the major-incident ticket (unique: one status
/// incident per ticket, so creating it from toggleMajorIncident is idempotent).
model StatusIncident {
  id          String    @id @default(cuid())
  title       String
  summary     String? // short public-facing description
  state       String    @default("INVESTIGATING") // INVESTIGATING | IDENTIFIED | MONITORING | RESOLVED
  impact      String    @default("MINOR") // NONE | MINOR | MAJOR | CRITICAL
  isPublic    Boolean   @default(false)
  ticketId    Int?      @unique
  startedAt   DateTime  @default(now())
  publishedAt DateTime? // first time it was made public
  resolvedAt  DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  ticket   Ticket?                 @relation(fields: [ticketId], references: [id], onDelete: SetNull)
  services StatusIncidentService[]
  updates  StatusIncidentUpdate[]

  @@index([isPublic, state])
  @@index([startedAt])
}

/// A service affected by a StatusIncident.
model StatusIncidentService {
  incidentId String
  serviceId  String

  incident StatusIncident @relation(fields: [incidentId], references: [id], onDelete: Cascade)
  service  Service        @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  @@id([incidentId, serviceId])
  @@index([serviceId])
}

/// One timeline entry on a StatusIncident. Visible publicly exactly when its
/// incident is public. `state` is the incident state announced with this update.
model StatusIncidentUpdate {
  id         String   @id @default(cuid())
  incidentId String
  state      String // INVESTIGATING | IDENTIFIED | MONITORING | RESOLVED
  body       String
  authorId   String?
  createdAt  DateTime @default(now())

  incident StatusIncident @relation(fields: [incidentId], references: [id], onDelete: Cascade)
  author   User?          @relation(fields: [authorId], references: [id], onDelete: SetNull)

  @@index([incidentId, createdAt])
}

// ---------------------------------------------------------------------------
// Releases & standard change templates
// ---------------------------------------------------------------------------

/// A bundle of changes deployed together. Int id, shown as REL-0001 via
/// releaseRef. The release window is derived from its changes' planned windows
/// (lib/release-rules.ts), never stored.
model Release {
  id          Int       @id @default(autoincrement())
  name        String
  description String?
  status      String    @default("PLANNING") // PLANNING | READY | IN_PROGRESS | DEPLOYED | CANCELLED
  ownerId     String?
  groupId     String?
  deployedAt  DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  owner   User?    @relation("ReleaseOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  group   Group?   @relation(fields: [groupId], references: [id], onDelete: SetNull)
  changes Change[]

  @@index([status])
}

/// A reusable, pre-filled change (standard change model). Creating a change from
/// a STANDARD template yields a STANDARD change, pre-approved through the
/// existing STANDARD path of submitChangeForApproval. `serviceId` scopes the
/// template in the picker (Change itself has no service column).
model ChangeTemplate {
  id                 String   @id @default(cuid())
  name               String   @unique
  summary            String? // when to use this template (shown in the picker)
  isActive           Boolean  @default(true)
  type               String   @default("STANDARD") // STANDARD | NORMAL
  title              String // prefilled change title
  description        String   @default("") // prefilled change description (plaintext)
  reason             String?
  implementationPlan String?
  rollbackPlan       String?
  risk               String   @default("LOW") // LOW | MEDIUM | HIGH
  priority           String   @default("MEDIUM") // LOW | MEDIUM | HIGH | CRITICAL
  impact             String   @default("MEDIUM") // LOW | MEDIUM | HIGH
  categoryId         String?
  serviceId          String?
  groupId            String?
  importRef          String?  @unique // origin key of a template maintained through the API; PUT /api/v1/change-templates/ref/{ref} upserts by it
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  category Category? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  service  Service?  @relation(fields: [serviceId], references: [id], onDelete: SetNull)
  group    Group?    @relation(fields: [groupId], references: [id], onDelete: SetNull)
  changes  Change[]

  @@index([isActive])
}

// ---------------------------------------------------------------------------
// Vendors, contracts & software licenses
// ---------------------------------------------------------------------------

model Vendor {
  id        String   @id @default(cuid())
  name      String   @unique
  website   String?
  email     String?
  phone     String?
  notes     String?
  isActive  Boolean  @default(true)
  importRef String?  @unique // origin key of a vendor maintained through the API; PUT /api/v1/vendors/ref/{ref} upserts by it
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  contracts Contract[]
  licenses  SoftwareLicense[]
}

/// A vendor contract. The owner receives renewal reminders `renewalNoticeDays`
/// before `endDate`; `renewalNotifiedFor` stores the endDate the reminder already
/// fired for, so it fires at most once per contract period (a renewal that moves
/// endDate re-arms it).
model Contract {
  id                 String    @id @default(cuid())
  name               String
  number             String? // vendor's contract / agreement number
  type               String    @default("SUPPORT") // SUPPORT | MAINTENANCE | LEASE | SUBSCRIPTION | WARRANTY | SERVICE | OTHER
  status             String    @default("ACTIVE") // DRAFT | ACTIVE | EXPIRED | TERMINATED
  vendorId           String?
  ownerId            String?
  startDate          DateTime? // optional: a contract recorded after the fact often has no known start; only endDate drives renewals
  endDate            DateTime?
  cost               Float?
  renewalNoticeDays  Int       @default(30)
  autoRenew          Boolean   @default(false)
  notes              String?
  renewalNotifiedFor DateTime? // endDate the renewal reminder fired for (at-most-once marker)
  importRef          String?   @unique // origin key of a contract maintained through the API; PUT /api/v1/contracts/ref/{ref} upserts by it
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  vendor   Vendor?           @relation(fields: [vendorId], references: [id], onDelete: SetNull)
  owner    User?             @relation("ContractOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  assets   ContractAsset[]
  licenses SoftwareLicense[]

  @@index([endDate])
  @@index([vendorId])
  @@index([status])
}

/// An asset covered by a contract.
model ContractAsset {
  contractId String
  assetId    String
  createdAt  DateTime @default(now())

  contract Contract @relation(fields: [contractId], references: [id], onDelete: Cascade)
  asset    Asset    @relation(fields: [assetId], references: [id], onDelete: Cascade)

  @@id([contractId, assetId])
  @@index([assetId])
}

/// A software license pool. Compliance = assignments used vs `seats`.
/// `overAllocatedNotifiedAt` is the at-most-once marker for the over-allocation
/// alert to the owner; clear it once the license is compliant again.
model SoftwareLicense {
  id                      String    @id @default(cuid())
  name                    String
  vendorId                String?
  contractId              String?
  ownerId                 String?
  licenseType             String    @default("PER_USER") // PER_USER | PER_DEVICE | SITE | CONCURRENT | SUBSCRIPTION
  seats                   Int       @default(1)
  expiresAt               DateTime?
  cost                    Float?
  notes                   String?
  overAllocatedNotifiedAt DateTime?
  createdAt               DateTime  @default(now())
  updatedAt               DateTime  @updatedAt

  vendor      Vendor?             @relation(fields: [vendorId], references: [id], onDelete: SetNull)
  contract    Contract?           @relation(fields: [contractId], references: [id], onDelete: SetNull)
  owner       User?               @relation("LicenseOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  assignments LicenseAssignment[]
  attachments Attachment[]

  @@index([vendorId])
  @@index([contractId])
  @@index([expiresAt])
}

/// One seat of a SoftwareLicense, assigned to a user and/or an asset (at least
/// one must be set, enforced by lib/actions/contracts.ts; NULLs make a DB unique
/// constraint useless here, so duplicates are prevented in the action).
model LicenseAssignment {
  id         String   @id @default(cuid())
  licenseId  String
  userId     String?
  assetId    String?
  assignedAt DateTime @default(now())

  license SoftwareLicense @relation(fields: [licenseId], references: [id], onDelete: Cascade)
  user    User?           @relation(fields: [userId], references: [id], onDelete: Cascade)
  asset   Asset?          @relation(fields: [assetId], references: [id], onDelete: Cascade)

  @@index([licenseId])
  @@index([userId])
  @@index([assetId])
}

// ---------------------------------------------------------------------------
// Sable insights (incident clusters, KB gaps)
// ---------------------------------------------------------------------------

/// A finding produced by the insights tick (lib/ticks/ai-insights.ts).
/// `dedupeKey` is unique so each finding is raised at most once; `payload` is a
/// JSON object with kind-specific detail (scores, terms, suggested title, ...).
/// problemId / articleId record the follow-up created from the insight.
model AiInsight {
  id            String    @id @default(cuid())
  kind          String // CLUSTER | KB_GAP
  status        String    @default("OPEN") // OPEN | ACTIONED | DISMISSED
  dedupeKey     String    @unique
  title         String
  summary       String?
  payload       String    @default("{}") // JSON object, kind-specific
  problemId     Int?
  articleId     String?
  dismissedById String?
  dismissedAt   DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  problem     Problem?          @relation(fields: [problemId], references: [id], onDelete: SetNull)
  article     Article?          @relation(fields: [articleId], references: [id], onDelete: SetNull)
  dismissedBy User?             @relation("AiInsightDismissedBy", fields: [dismissedById], references: [id], onDelete: SetNull)
  tickets     AiInsightTicket[]

  @@index([kind, status])
  @@index([createdAt])
}

/// A ticket an AiInsight refers to (cluster members / KB-gap evidence).
model AiInsightTicket {
  insightId String
  ticketId  Int

  insight AiInsight @relation(fields: [insightId], references: [id], onDelete: Cascade)
  ticket  Ticket    @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  @@id([insightId, ticketId])
  @@index([ticketId])
}

// A planned period during which the admins update Servio or do other maintenance.
// While IN_PROGRESS with blockAccess, non-admins see the maintenance page
// (the flag file in SERVIO_STATE_DIR, written by lib/maintenance.ts).
model MaintenanceWindow {
  id            String    @id @default(cuid())
  title         String
  message       String? // shown to users in banners and on /maintenance
  kind          String    @default("GENERAL") // GENERAL | UPDATE
  status        String    @default("SCHEDULED") // SCHEDULED | IN_PROGRESS | COMPLETED | FAILED | ROLLED_BACK | CANCELLED
  startsAt      DateTime
  endsAt        DateTime // planned end; GENERAL windows end automatically here
  announceHours Int       @default(24) // banners are visible from startsAt - announceHours
  blockAccess   Boolean   @default(true) // maintenance mode for non-admins while IN_PROGRESS
  targetVersion String? // UPDATE only
  fromVersion   String?
  startedAt     DateTime?
  finishedAt    DateTime?
  result        String? // last updater message or failure reason
  log           String    @default("[]") // JSON array copied from the updater's status.json
  createdById   String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  createdBy User? @relation(fields: [createdById], references: [id], onDelete: SetNull)

  @@index([status, startsAt])
}

// One run of the built-in backup (lib/backup.ts): a snapshot of the SQLite
// database plus an archive of the uploads, verified before it is kept.
// The files live in BACKUP_DIR/<name>; `prunedAt` is set when retention removed them.
model BackupRun {
  id            String    @id @default(cuid())
  status        String    @default("RUNNING") // RUNNING | SUCCESS | FAILED
  trigger       String    @default("SCHEDULE") // SCHEDULE | MANUAL | CLI
  startedAt     DateTime  @default(now())
  finishedAt    DateTime?
  heartbeatAt   DateTime  @default(now()) // refreshed while RUNNING; a stale one marks an interrupted run
  name          String? // backup directory inside BACKUP_DIR
  databaseBytes Float? // bytes; Float because Int caps at 2 GiB
  uploadsBytes  Float? // size of the uploads archive
  uploadsFiles  Int?
  verified      Boolean   @default(false)
  details       String    @default("{}") // JSON: verification checks, warnings, pruned backups
  error         String? // full message, shown to admins only
  errorCode     String? // coarse class (lib/backup-rules.ts BACKUP_ERROR_CODES), the only failure detail the API reports
  prunedAt      DateTime?
  triggeredById String?
  createdAt     DateTime  @default(now())

  triggeredBy User? @relation(fields: [triggeredById], references: [id], onDelete: SetNull)

  @@index([status, startedAt])
  @@index([startedAt])
}

/// A ticket created on a schedule (GLPI "recurrent items"): a ticket template
/// plus a recurrence. Occurrence n falls on `firstDueAt` + n x `interval`
/// `frequency` units, keeping the wall-clock time in `timezone` (month ends clamp:
/// Jan 31 -> Feb 28/29 -> Mar 31). Each occurrence's ticket is created
/// `createBeforeDays` days before it is due, by lib/ticks/recurring-tickets.ts
/// through the normal ticket pipeline (source RECURRING). `nextDueAt` is claimed
/// with a conditional update before the ticket is created, so an occurrence is
/// created at most once. Math in lib/recurring-ticket-rules.ts.
model RecurringTicket {
  id               String    @id @default(cuid())
  name             String
  isActive         Boolean   @default(true)
  // ---- ticket template ----
  title            String
  description      String    @default("")
  type             String    @default("REQUEST") // INCIDENT | REQUEST
  priority         String    @default("MEDIUM") // LOW | MEDIUM | HIGH | CRITICAL
  impact           String    @default("MEDIUM") // LOW | MEDIUM | HIGH
  urgency          String    @default("MEDIUM") // LOW | MEDIUM | HIGH
  requesterId      String? // null = the schedule's creator
  assigneeId       String?
  groupId          String?
  categoryId       String?
  serviceId        String?
  // ---- recurrence ----
  frequency        String    @default("MONTHLY") // DAILY | WEEKLY | MONTHLY | YEARLY
  interval         Int       @default(1) // every N frequency units
  timezone         String    @default("UTC") // IANA zone the due time is expressed in
  firstDueAt       DateTime // due instant of occurrence 0 (UTC)
  createBeforeDays Int       @default(0) // lead time: the ticket is created this many days before it is due
  nextDueAt        DateTime // due instant of the next occurrence still to create (claim marker)
  lastCreatedFor   DateTime? // due instant of the last occurrence a ticket was created for
  lastTicketId     Int? // the ticket created for lastCreatedFor (plain id; the ticket may be deleted)
  lastError        String? // why the last attempt failed (cleared on success)
  importRef        String?   @unique // origin of a schedule imported via POST /api/v1/recurring-tickets (e.g. "glpi:ticketrecurrent:7")
  createdById      String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  requester User?     @relation("RecurringTicketRequester", fields: [requesterId], references: [id], onDelete: SetNull)
  assignee  User?     @relation("RecurringTicketAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  createdBy User?     @relation("RecurringTicketCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  group     Group?    @relation(fields: [groupId], references: [id], onDelete: SetNull)
  category  Category? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  service   Service?  @relation(fields: [serviceId], references: [id], onDelete: SetNull)

  @@index([isActive, nextDueAt])
}
