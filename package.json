{
  "name": "servio",
  "version": "0.6.8",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "node scripts/sync-brand-assets.mjs --check && next build",
    "brand:sync": "node scripts/sync-brand-assets.mjs",
    "brand:check": "node scripts/sync-brand-assets.mjs --check",
    "benchmark:chart": "node scripts/benchmark-chart.mjs",
    "release": "node scripts/release.mjs",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:migrate:new": "node scripts/new-migration.mjs",
    "db:push": "prisma db push",
    "db:seed": "prisma db seed",
    "db:reset": "prisma migrate reset --force",
    "db:studio": "prisma studio",
    "setup": "prisma migrate deploy && prisma db seed",
    "docs:check": "node scripts/check-doc-drift.mjs --working",
    "hooks:install": "git config core.hooksPath .githooks",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
